# OCR — copia a apps/web/.env (frontend) o exporta en la shell (scripts / CDK).
# No commits values reales de tu cuenta AWS.

# --- Frontend (apps/web) ---
# Output ApiUrl tras `cdk deploy`
PUBLIC_API_BASE_URL=https://xxxxxxxx.execute-api.region.amazonaws.com

# --- Scripts operativos (cleanup, backfill) ---
# Outputs TableName / DocsBucketName (o env de las Lambdas)
TABLE_NAME=
DOCS_BUCKET_NAME=
# Alias aceptado por scripts/cleanup-orphans-and-non-pdf.py
# API_BASE_URL=

# Backfill analytics (opcional)
# FORCE=1
# ANALYTICS_PARSER=bedrock
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# --- Deploy Amplify (scripts/deploy-amplify.sh) ---
# STACK_NAME=OcrStack
# AMPLIFY_APP_ID=
# AMPLIFY_BRANCH=main
# (si faltan APP_ID / API, se leen de CloudFormation con STACK_NAME)

# --- CDK ---
# CDK_DEFAULT_ACCOUNT=
# CDK_DEFAULT_REGION=

# --- Auth local (API sin Secrets Manager) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=
# AUTH_JWT_SECRET=
# AUTH_SECRET_ARN=
