---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Upload" active="upload">
  <h1>Upload</h1>
  <p class="lede">
    JPEG, PNG o PDF. Cada archivo se firma y sube por separado (con reintentos).
    Los PDF van con menos concurrencia porque pesan más; el OCR corre en background.
  </p>

  <div class="panel" id="upload-root" data-api-ready="false">
    <div class="dropzone" id="dropzone" tabindex="0" role="button" aria-label="Seleccionar documentos">
      <strong>Arrastra imágenes o PDFs aquí</strong>
      <div>o haz click para elegir archivos</div>
      <input id="file-input" type="file" accept="image/jpeg,image/png,application/pdf" multiple hidden />
    </div>

    <ul class="file-list" id="file-list"></ul>

    <div class="row" style="margin-top: 1rem;">
      <button class="btn" id="upload-btn" type="button" disabled>Subir todos</button>
      <button class="btn btn-ghost" id="clear-btn" type="button">Limpiar</button>
      <button class="btn btn-ghost" id="retry-btn" type="button" hidden>Reintentar fallidos</button>
    </div>
    <p class="muted" id="upload-progress" hidden></p>
    <p class="success-msg" id="upload-success" hidden></p>
    <p class="error" id="upload-error" hidden></p>
    <p class="muted" id="upload-hint"></p>
  </div>
</BaseLayout>

<script>
  import { api, getApiBaseUrl, ApiClientError } from "../lib/api";

  type QueueItem = {
    file: File;
    status: "pending" | "uploading" | "done" | "error";
    message?: string;
    documentId?: string;
  };

  const allowed = new Set(["image/jpeg", "image/png", "application/pdf"]);
  const queue: QueueItem[] = [];
  const maxRetries = 3;
  let uploading = false;

  const dropzone = document.getElementById("dropzone")!;
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const fileList = document.getElementById("file-list")!;
  const uploadBtn = document.getElementById("upload-btn") as HTMLButtonElement;
  const clearBtn = document.getElementById("clear-btn") as HTMLButtonElement;
  const retryBtn = document.getElementById("retry-btn") as HTMLButtonElement;
  const errorEl = document.getElementById("upload-error")!;
  const successEl = document.getElementById("upload-success")!;
  const progressEl = document.getElementById("upload-progress")!;
  const hintEl = document.getElementById("upload-hint")!;

  if (!getApiBaseUrl()) {
    hintEl.textContent =
      "Define PUBLIC_API_BASE_URL (output ApiUrl de cdk deploy) y reinicia astro dev.";
  } else {
    hintEl.textContent = `API: ${getApiBaseUrl()}`;
  }

  function concurrencyFor(files: QueueItem[]): number {
    const hasHeavyPdf = files.some(
      (item) => item.file.type === "application/pdf" && item.file.size > 2 * 1024 * 1024,
    );
    return hasHeavyPdf ? 2 : 4;
  }

  function render() {
    const failed = queue.filter((item) => item.status === "error").length;
    fileList.innerHTML = queue
      .map((item) => {
        const badgeClass =
          item.status === "done"
            ? "ok"
            : item.status === "error"
              ? "danger"
              : item.status === "uploading"
                ? "warn"
                : "";
        const label =
          item.status === "done"
            ? "subida"
            : item.status === "uploading"
              ? "subiendo"
              : item.status === "error"
                ? "error"
                : "pendiente";
        return `<li><span>${item.file.name} · ${(item.file.size / 1024).toFixed(1)} KB</span><span class="badge ${badgeClass}">${label}${item.message ? ` — ${item.message}` : ""}</span></li>`;
      })
      .join("");
    uploadBtn.disabled =
      uploading ||
      queue.every((item) => item.status === "done") ||
      queue.length === 0 ||
      !getApiBaseUrl();
    retryBtn.hidden = failed === 0 || uploading;
    clearBtn.disabled = uploading;
  }

  function addFiles(files: FileList | File[]) {
    errorEl.hidden = true;
    successEl.hidden = true;
    for (const file of Array.from(files)) {
      if (!allowed.has(file.type)) {
        errorEl.hidden = false;
        errorEl.textContent = `Archivo rechazado (solo JPEG/PNG/PDF; Textract no soporta WebP): ${file.name}`;
        continue;
      }
      queue.push({ file, status: "pending" });
    }
    render();
  }

  async function sleep(ms: number) {
    await new Promise((resolve) => setTimeout(resolve, ms));
  }

  async function putWithRetry(
    uploadUrl: string,
    headers: Record<string, string>,
    file: File,
  ): Promise<void> {
    let lastError: unknown;
    for (let attempt = 1; attempt <= maxRetries; attempt++) {
      try {
        const put = await fetch(uploadUrl, {
          method: "PUT",
          headers,
          body: file,
        });
        if (!put.ok) {
          throw new Error(`S3 PUT ${put.status}`);
        }
        return;
      } catch (error) {
        lastError = error;
        if (attempt < maxRetries) {
          await sleep(500 * 2 ** (attempt - 1));
        }
      }
    }
    throw lastError instanceof Error ? lastError : new Error("upload failed");
  }

  /** One file: presign → PUT (retries). Avoids orphan META for files never attempted. */
  async function uploadOne(item: QueueItem): Promise<void> {
    item.status = "uploading";
    item.message = "firmando…";
    render();

    const { uploads } = await api.presign([
      {
        filename: item.file.name,
        contentType: item.file.type,
        sizeBytes: item.file.size,
      },
    ]);
    const signed = uploads[0];
    if (!signed) {
      throw new Error("Presign vacío");
    }

    item.documentId = signed.documentId;
    item.message = "subiendo…";
    render();

    await putWithRetry(signed.uploadUrl, signed.headers, item.file);
    item.status = "done";
    item.message = "en cola para OCR";
  }

  async function runQueue(items: QueueItem[]) {
    if (items.length === 0) return;

    uploading = true;
    errorEl.hidden = true;
    successEl.hidden = true;
    progressEl.hidden = false;
    render();

    const concurrency = concurrencyFor(items);
    let index = 0;
    let doneCount = 0;
    let failCount = 0;

    async function worker() {
      while (index < items.length) {
        const current = index++;
        const item = items[current];
        progressEl.textContent = `Subiendo ${Math.min(doneCount + failCount + 1, items.length)}/${items.length} (concurrencia ${concurrency})…`;
        try {
          await uploadOne(item);
          doneCount += 1;
        } catch (error) {
          item.status = "error";
          item.message =
            error instanceof ApiClientError
              ? error.message
              : error instanceof Error
                ? error.message
                : "upload failed";
          failCount += 1;
        }
        render();
      }
    }

    try {
      await Promise.all(
        Array.from({ length: Math.min(concurrency, items.length) }, () => worker()),
      );

      if (doneCount > 0) {
        successEl.hidden = false;
        successEl.innerHTML =
          doneCount === 1
            ? `Documento subido correctamente. El OCR se ejecuta en background — <a href="/documents">ver documentos</a>.`
            : `${doneCount} documentos subidos correctamente. El OCR se ejecuta en background — <a href="/documents">ver documentos</a>.`;
        if (failCount > 0) {
          successEl.innerHTML += ` (${failCount} fallaron — usa Reintentar fallidos)`;
        }
      } else if (failCount > 0) {
        errorEl.hidden = false;
        errorEl.textContent = `Ningún archivo se subió (${failCount} fallaron).`;
      }
    } finally {
      uploading = false;
      progressEl.hidden = true;
      render();
    }
  }

  dropzone.addEventListener("click", () => {
    if (!uploading) fileInput.click();
  });
  dropzone.addEventListener("keydown", (event) => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      if (!uploading) fileInput.click();
    }
  });
  fileInput.addEventListener("change", () => {
    if (fileInput.files) addFiles(fileInput.files);
    fileInput.value = "";
  });
  dropzone.addEventListener("dragover", (event) => {
    event.preventDefault();
    dropzone.classList.add("dragover");
  });
  dropzone.addEventListener("dragleave", () => dropzone.classList.remove("dragover"));
  dropzone.addEventListener("drop", (event) => {
    event.preventDefault();
    dropzone.classList.remove("dragover");
    if (!uploading && event.dataTransfer?.files) addFiles(event.dataTransfer.files);
  });

  clearBtn.addEventListener("click", () => {
    if (uploading) return;
    queue.splice(0, queue.length);
    successEl.hidden = true;
    errorEl.hidden = true;
    progressEl.hidden = true;
    render();
  });

  uploadBtn.addEventListener("click", () => {
    const pending = queue.filter((item) => item.status === "pending");
    void runQueue(pending);
  });

  retryBtn.addEventListener("click", () => {
    const failed = queue.filter((item) => item.status === "error");
    for (const item of failed) {
      item.status = "pending";
      item.message = undefined;
      item.documentId = undefined;
    }
    void runQueue(failed);
  });

  window.addEventListener("beforeunload", (event) => {
    if (uploading) {
      event.preventDefault();
      event.returnValue = "";
    }
  });

  render();
</script>
